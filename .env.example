# Copy this file to .env and fill in your real keys.
# Never commit .env to version control.

# Get a FREE Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Gemini model to use for chat (default shown)
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite

# Embeddings run LOCALLY via sentence-transformers — no API key needed!
# Model is ~90MB and is downloaded + cached automatically on first run.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Path where ChromaDB will persist the vector index on disk
CHROMA_PERSIST_DIR=./chroma_db
